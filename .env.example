DATABASE_URL=sqlite:///./document_intelligence.db
SECRET_KEY=replace-me-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=replace-with-your-Google-AI-Studio-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_CONCURRENT_REQUESTS=8
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
AUTO_MIGRATE=true
LOG_LEVEL=INFO
LOG_FORMAT=json
INGESTION_WORKER_ENABLED=true
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
MAX_PDF_PAGES=500
MAX_PDF_CHARS=500000
PDF_PARSE_TIMEOUT_SECONDS=60
PDF_PARSE_MEMORY_MB=1024
AUTH_REQUESTS_PER_MINUTE=30
UPLOAD_REQUESTS_PER_MINUTE=8
CHAT_REQUESTS_PER_MINUTE=20
DEFAULT_REQUESTS_PER_MINUTE=120
MAX_RATE_LIMIT_KEYS=10000
# Used only by docker-compose.yml for the bundled PostgreSQL database.
POSTGRES_PASSWORD=
