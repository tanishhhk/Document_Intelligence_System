DATABASE_URL=sqlite:///./document_intelligence.db
SECRET_KEY=replace-me-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Answer providers, tried in this order. Configure any subset; the rest are skipped.
LLM_PROVIDERS=ollama,openrouter,groq,gemini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CONCURRENT_REQUESTS=8
# extractive: when no provider answers, return the best passages, labelled as such.
ANSWER_FALLBACK=extractive
# Local and private. Enabled by choosing a model, e.g. qwen3:8b.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
AUTO_MIGRATE=true
LOG_LEVEL=INFO
LOG_FORMAT=json
INGESTION_WORKER_ENABLED=true
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
MAX_PDF_PAGES=500
MAX_PDF_CHARS=500000
PDF_PARSE_TIMEOUT_SECONDS=60
PDF_PARSE_MEMORY_MB=1024
# Document stories: the text story is always made; the video when rendering works.
VIDEO_DIR=./generated_videos
VIDEO_RENDER_ENABLED=true
VIDEO_RENDER_TIMEOUT_SECONDS=900
VIDEO_RENDER_MEMORY_MB=2048
VIDEOS_KEPT_PER_USER=3
TTS_VOICE=en-US-AriaNeural
STORY_SOURCE_CHARS=12000
STORY_TIMEOUT_SECONDS=90
AUTH_REQUESTS_PER_MINUTE=30
UPLOAD_REQUESTS_PER_MINUTE=8
CHAT_REQUESTS_PER_MINUTE=20
VIDEO_REQUESTS_PER_MINUTE=3
DEFAULT_REQUESTS_PER_MINUTE=120
MAX_RATE_LIMIT_KEYS=10000
# Used only by docker-compose.yml for the bundled PostgreSQL database.
POSTGRES_PASSWORD=
